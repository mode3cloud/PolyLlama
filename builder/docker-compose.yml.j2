name: mode3ai_polyllama

services:
  # openwebui:
  #     build:
  #       context: ../../stack/open-webui
  #       dockerfile: Dockerfile
  #     container_name: openwebui
  #     ports:
  #       - "8080:8080"
  #     volumes:
  #       - openwebui_data:/app/backend/data

  olah:
    build:
      context: ../../stack/olah
      dockerfile: Dockerfile
    container_name: olah
    volumes:
      - olah_data_repos:/app/repos
      - olah_data_mirrors:/app/mirrors

  kokoro-tts:
    image: ghcr.io/remsky/kokoro-fastapi-gpu:latest
    container_name: kokoro-tts
    hostname: kokoro-tts
    ports:
      - "8880:8880"
    # environment:
    #   - MODEL_DIR=/app/models
    volumes:
      - kokoro_models:/app/models
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              capabilities: [ gpu ]
              count: 1

  redis:
    image: redis:7-alpine
    container_name: redis
    hostname: redis
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data

  # MCP Bridge service - provides tool discovery and execution
  mcp-bridge:
    build:
      context: ../..
      dockerfile: stack/mcp-bridge/Dockerfile
    container_name: mcp-bridge
    hostname: mcp-bridge
    ports:
      - "3001:3001"  # MCP endpoint
    env_file:
      - ../../.env
    environment:
      - MCP_CONFIG_PATH=/app/mcp-config.json
      - MCP_SERVER_PORT=3001
      - MCP_SERVER_HOST=0.0.0.0
      - REDIS_HOST=redis
      - PYTHONUNBUFFERED=1
{% if dev_mode %}
      - DEV_MODE=true
{% endif %}
    volumes:
      - ../../mcp-config.json:/app/mcp-config.json:ro
{% if dev_mode %}
      # Development mode: bind mount the source code for hot reload
      - ../../stack/mcp-bridge/mcp_bridge_server.py:/app/mcp_bridge_server.py:ro
      - ../../stack/llm-proxy/services:/app/services:ro
      - ../../stack/llm-proxy/mcp_server_fastmcp.py:/app/mcp_server_fastmcp.py:ro
{% endif %}
    depends_on:
      - redis
{% if dev_mode %}
    # In dev mode, use watchdog for auto-restart on file changes
    command: ["sh", "-c", "pip install watchdog[watchmedo] && { npm install -g @modelcontextprotocol/server-github @modelcontextprotocol/server-sequential-thinking @upstash/context7-mcp @browsermcp/mcp@latest firecrawl-mcp @hubspot/mcp-server @tiberriver256/mcp-server-azure-devops mcp-remote@latest n8n-mcp & touch /app/mcp-packages-installed.flag & }; watchmedo auto-restart --directory=/app --pattern='*.py' --recursive -- python -u mcp_bridge_server.py"]
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001/health"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 20s
  
{% for instance in ollama_instances %}
  polyllama{{ instance.number }}:
    container_name: polyllama{{ instance.number }}
    hostname: polyllama{{ instance.number }}
    build:
      dockerfile: Dockerfile
      context: ../../stack/ollama
    volumes:
      - ~/.cache/huggingface/hub:/root/.cache/huggingface/hub
      - ~/ollama:/root/.ollama
    env_file:
      - ../../.env
    environment:
{% if instance.gpu_indices %}
      - CUDA_VISIBLE_DEVICES={{ instance.gpu_indices }}
{% endif %}
      - OLLAMA_SCHED_SPREAD=1
      - CUDA_DEVICE_ORDER=PCI_BUS_ID
    deploy:
      resources:
        limits:
          memory: {{ instance.memory_limit }}g
{% if instance.gpu_indices %}
        reservations:
          devices:
            - driver: nvidia
              capabilities: [ gpu ]
{% endif %}

{% endfor %}

  router:
    container_name: router
    hostname: router
    build:
      context: ../../stack/polyllama
      dockerfile: Dockerfile
{% if dev_mode %}
      target: development
{% else %}
      target: production
{% endif %}
    volumes:
      - ../../stack/polyllama/model_router.lua:/usr/local/openresty/lualib/model_router.lua
      - ../../stack/polyllama/provider_router.lua:/usr/local/openresty/lualib/provider_router.lua
      - ../../stack/polyllama/session_manager.lua:/usr/local/openresty/lualib/session_manager.lua
      - ../../stack/polyllama/mcp_manager.lua:/usr/local/openresty/lualib/mcp_manager.lua
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
{% if dev_mode %}
      # Development mode: bind mount the app source
      - ../../stack/polyllama/ui:/app
      # Preserve node_modules in the container
      - /app/node_modules
      - /app/.next
{% endif %}
    ports:
      - "11434:11434"
    env_file:
      - ../../.env
    environment:
      - OLLAMA_INSTANCE_COUNT={{ instance_count }}
    depends_on:
{% for instance in ollama_instances %}
      - polyllama{{ instance.number }}
{% endfor %}
      - mcp-bridge

volumes:
  openwebui_data:
  olah_data_repos:
  olah_data_mirrors:
  kokoro_models:
  redis_data: