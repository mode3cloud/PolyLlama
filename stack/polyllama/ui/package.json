{
  "name": "polyllama-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm compilets && next build",
    "prodbuild": "pnpm install --frozen-lockfile && pnpm build && pnpm install --prod --frozen-lockfile",
    "start": "next start -p 3000",
    "lint": "cross-env TIMING=1 next lint",
    "compilets": "pnpm exec tsc --pretty",
    "pretty": "pnpm prettychanged && pnpm prettynew",
    "prettychanged": "pnpm prettier --write $(git diff --name-only --diff-filter d | grep -v -e 'yarn.lock' -e 'pnpm-lock.yml' -e 'package.json' -e '.prettierignore' | xargs)",
    "prettynew": "pnpm prettier --write $(git ls-files --others --exclude-standard | grep -v -e 'yarn.lock' -e 'pnpm-lock.yml' -e 'package.json' -e '.prettierignore' | xargs)",
    "prettyall": "pnpm prettier --write .",
    "updateall": "pnpm update -i --latest"
  },
  "dependencies": {
    "@azure/msal-node": "^3.6.0",
    "@heroicons/react": "^2.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.2",
    "next": "15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "postcss": "^8.5.4",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}